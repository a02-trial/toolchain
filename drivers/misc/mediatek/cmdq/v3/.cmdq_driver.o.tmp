-Wp,-MD,drivers/misc/mediatek/cmdq/v3/.cmdq_driver.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-Werror
-I./drivers/misc/mediatek/include
-I./drivers/misc/mediatek/include/mt-plat/mt6739/include/
-I./drivers/misc/mediatek/include/mt-plat/
-I./drivers/mmc/host/mediatek/mt6739
-I./drivers/misc/mediatek/smi/
-I./drivers/misc/mediatek/smi/mt6739/
-I./drivers/misc/mediatek/mmdvfs/
-I./drivers/misc/mediatek/mmp/
-I./drivers/misc/mediatek/mdp/
-I./drivers/iommu/
-I./drivers/misc/mediatek/m4u/mt6739
-I./drivers/misc/mediatek/mach/mt6739/include
-I./drivers/misc/mediatek/cmdq/v3/mt6739/
-DCMDQ_TEST_PROC
-DCMDQ_SPECIAL_ESD_PRIORITY
-D_CMDQ_DISABLE_MARKER_
-DCMDQ_LARGE_MAX_FIRSTERROR_BUFFER
-DKBUILD_BASENAME=\cmdq_driver' -DKBUILD_MODNAME='cmdq_driver' -c -o drivers/misc/mediatek/cmdq/v3/.tmp_cmdq_driver.o drivers/misc/mediatek/cmdq/v3/cmdq_driver.c
