-Wp,-MD,drivers/misc/mediatek/smi/.smi_drv.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-Werror
-I./drivers/misc/mediatek/include
-I./drivers/misc/mediatek/include/mt-plat/mt6739/include/
-I./drivers/misc/mediatek/include/mt-plat/
-I./drivers/mmc/host/mediatek/mt6739
-I./drivers/clk/mediatek/
-I./drivers/misc/mediatek/cmdq/v3/
-I./drivers/misc/mediatek/cmdq/v3/mt6739/
-I./drivers/misc/mediatek/cmdq/mailbox/
-I./drivers/misc/mediatek/emi/mt6739/
-I./drivers/misc/mediatek/emi_bwl/mt6739/
-I./drivers/misc/mediatek/m4u/mt6739/
-I./drivers/misc/mediatek/mmdvfs/
-I./drivers/misc/mediatek/smi/mt6739/
-I./drivers/misc/mediatek/base/power/include/
-I./drivers/misc/mediatek/dramc/mt6739/
-I./drivers/misc/mediatek/mmp/
-I./drivers/misc/mediatek/sspm/mt6739/
-I./drivers/misc/mediatek/freqhopping/
-I./drivers/misc/mediatek/freqhopping/mt6739
-DSMI_ZIO
-DMMDVFS_HOOK
-I./drivers/clk/mediatek
-I./drivers/misc/mediatek/sspm/
-DSMI_CCF_NO_DUMP
-DKBUILD_BASENAME=\smi_drv' -DKBUILD_MODNAME='smi_drv' -c -o drivers/misc/mediatek/smi/.tmp_smi_drv.o drivers/misc/mediatek/smi/smi_drv.c
