-Wp,-MD,drivers/misc/mediatek/gpu/ged/src/.ged.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-Werror
-I./drivers/misc/mediatek/include
-I./drivers/misc/mediatek/include/mt-plat/mt6739/include/
-I./drivers/misc/mediatek/include/mt-plat/
-I./drivers/mmc/host/mediatek/mt6739
-Wno-error
-DMTK_GED_KPI
-DGED_KPI_CPU_BOOST
-DGED_SKI_SUPPORT
-DGED_ENABLE_FB_DVFS
-I./drivers/misc/mediatek/cmdq/v3
-I./drivers/misc/mediatek/cmdq/v3/mt6739
-I./drivers/misc/mediatek//base/power/mt6739/
-I./drivers/misc/mediatek/video/mt6739/videox
-I./drivers/misc/mediatek/video/mt6739/dispsys
-I./drivers/misc/mediatek/sspm/mt6739
-DMET_USER_EVENT_SUPPORT
-DMTK_GPU_DVFS
-DGED_DVFS_DEBUG_BUF
-DENABLE_COMMON_DVFS
-DENABLE_TIMER_BACKUP
-DGED_DVFS_ENABLE
-include
./drivers/misc/mediatek/gpu/ged/include/config_kernel_user.h
-I./include/
-I./drivers/misc/mediatek//include/
-I./drivers/misc/mediatek/gpu/ged/include/
-I./drivers/gpu/mediatek//hal/
-I./drivers/gpu/mediatek//
-I./drivers/misc/mediatek//base/power/include/
-I./drivers/misc/mediatek/video/include
-I./drivers/misc/mediatek/lcm/inc/
-I./drivers/misc/mediatek/dfrc/
-I./drivers/gpu/mediatek/gpufreq/include/
-I./drivers/misc/mediatek/sspm/
-DKBUILD_BASENAME=\ged' -DKBUILD_MODNAME='ged' -c -o drivers/misc/mediatek/gpu/ged/src/.tmp_ged.o drivers/misc/mediatek/gpu/ged/src/ged.c
