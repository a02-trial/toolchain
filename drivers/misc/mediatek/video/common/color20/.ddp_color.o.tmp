-Wp,-MD,drivers/misc/mediatek/video/common/color20/.ddp_color.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-Werror
-I./drivers/misc/mediatek/include
-I./drivers/misc/mediatek/include/mt-plat/mt6739/include/
-I./drivers/misc/mediatek/include/mt-plat/
-I./drivers/mmc/host/mediatek/mt6739
-I./drivers/misc/mediatek/mmp/
-I./drivers/misc/mediatek/m4u/mt6739
-I./drivers/misc/mediatek/video/include/
-I./drivers/misc/mediatek/video/common/
-I./drivers/misc/mediatek/video/mt6739/videox/
-I./drivers/misc/mediatek/base/power/mt6755/
-I./drivers/misc/mediatek/lcm/inc
-I./drivers/misc/mediatek/m4u/mt6739/
-I./drivers/misc/mediatek/mmp/
-I./drivers/misc/mediatek/video/mt6739/dispsys
-I./drivers/misc/mediatek/cmdq/v3/
-I./drivers/misc/mediatek/cmdq/v3/mt6739/
-DCCORR_SUPPORT
-DDISP_COLOR_ON
-DKBUILD_BASENAME=\ddp_color' -DKBUILD_MODNAME='ddp_color' -c -o drivers/misc/mediatek/video/common/color20/.tmp_ddp_color.o drivers/misc/mediatek/video/common/color20/ddp_color.c
