-Wp,-MD,drivers/i2c/busses/.i2c-gpio.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-I./drivers/misc/mediatek/include
-I./drivers/misc/mediatek/include/mt-plat
-I./drivers/misc/mediatek/scp/mt6739/
-DKBUILD_BASENAME=\i2c_gpio' -DKBUILD_MODNAME='i2c_gpio' -c -o drivers/i2c/busses/.tmp_i2c-gpio.o drivers/i2c/busses/i2c-gpio.c
