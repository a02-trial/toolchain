-Wp,-MD,drivers/clocksource/.timer-probe.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-Werror
-I./drivers/misc/mediatek/include
-I./kernel/time
-Wno-error=implicit-function-declaration
-Wno-error=strict-prototypes
-DKBUILD_BASENAME=\timer_probe' -DKBUILD_MODNAME='timer_probe' -c -o drivers/clocksource/.tmp_timer-probe.o drivers/clocksource/timer-probe.c
