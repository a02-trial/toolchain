-Wp,-MD,drivers/gpu/drm/.drm_prime.o.d
-nostdinc
-isystem
-I./arch/arm/include
-I./arch/arm/include/generated
-I./drivers/misc/mediatek/include
-I./include
-I./arch/arm/include/uapi
-I./arch/arm/include/generated/uapi
-I./include/uapi
-I./include/generated/uapi
-include
./include/linux/kconfig.h
-D__KERNEL__
-mlittle-endian
-Wall
-Wundef
-Wstrict-prototypes
-Wno-trigraphs
-fno-strict-aliasing
-fno-common
-fshort-wchar
-Werror-implicit-function-declaration
-Wno-format-security
-std=gnu89
-fno-omit-frame-pointer
-mapcs
-mno-sched-prolog
-mabi=aapcs-linux
-mfpu=vfp
-Wa,-W
-D__LINUX_ARM_ARCH__=7
-march=armv5t
-Wa,-march=armv7-a
-msoft-float
-Uarm
-Os
-fstack-protector-strong
-fno-omit-frame-pointer
-fno-optimize-sibling-calls
-g
-I./drivers/gpu/drm/mediatek/
-I./drivers/misc/mediatek/dramc/mt6739
-I./drivers/misc/mediatek/smi/
-I./drivers/misc/mediatek/mmp/
-I./drivers/misc/mediatek/mmdvfs/
-I./drivers/iommu/
-I./drivers/devfreq/
-I./drivers/gpu/drm/
-I./drivers/misc/mediatek/include/mt-plat/mt6739/include/mach/
-I./drivers/misc/mediatek/include/mt-plat
-I./drivers/misc/mediatek/leds/
-I./drivers/misc/mediatek/leds/mt6739
-DKBUILD_BASENAME=\drm_prime' -DKBUILD_MODNAME='drm' -c -o drivers/gpu/drm/.tmp_drm_prime.o drivers/gpu/drm/drm_prime.c
